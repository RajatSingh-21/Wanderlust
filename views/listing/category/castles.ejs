<% layout("/layouts/boilerplate")%>

<style>
  #filters {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    justify-content: space-evenly;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
  }
  .filter i {
    font-size: 18px;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .filter p {
    font-size: 0.85rem;
  }
  .filter a {
    text-decoration: none;
    color: black;
  }
  .tax-info {
    display: none;
  }
  .tax-toggle {
    border: 0.5px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    margin-left: none;
    display: flex;
    align-items: center;
  }
  /* Category Icons */
  .filter {
    transition: all 0.3s;
    padding: 1rem;
    border-radius: 12px;
    text-align: center;
    cursor: pointer;
  }

  .filter:hover {
    background: #f8f9fa;
    transform: translateY(-3px);
  }

  .filter.active {
    background: #fe424d;
    color: white;
  }

  .filter i {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    display: block;
  }
  /* Category Filter Improvements */
  .filter {
    padding: 12px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 8px;
    margin-bottom: 5px;
  }

  .filter:hover {
    background-color: #f8f9fa;
    transform: translateY(-2px);
  }

  .filter i {
    font-size: 1.5rem;
    margin-bottom: 5px;
    display: block;
  }

  .filter p {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
  }
</style>
<div id="filters">
  <div class="filter">
    <a href="/listings/category/trending"
      ><div><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p></a
    >
  </div>

  <div class="filter" data-toggle="collapse">
    <a href="/listings/category/rooms"
      ><div><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p></a
    >
  </div>
  <div class="filter">
    <a href="/listings/category/cities"
      ><div><i class="fa-solid fa-mountain-city"></i></div>
      <p>Cities</p></a
    >
  </div>
  <div class="filter">
    <a href="/listings/category/mountains">
      <div><i class="fa-solid fa-mountain-sun"></i></div>
      <p>Mountains</p></a
    >
  </div>

  <div class="filter">
    <a href="/listings/category/castles">
      <div><i class="fa-solid fa-chess-rook"></i></div>
      <p>Castles</p>
    </a>
  </div>

  <div class="filter">
    <a href="/listings/category/pools">
      <div><i class="fa-solid fa-person-swimming"></i></div>
      <p>Pools</p></a
    >
  </div>
  <div class="filter">
    <a href="/listings/category/camping">
      <div><i class="fa-solid fa-campground"></i></div>
      <p>Camping</p></a
    >
  </div>

  <div class="filter">
    <a href="/listings/category/farm">
      <div><i class="fa-solid fa-cow"></i></div>
      <p>Farm</p></a
    >
  </div>

  <div class="filter">
    <a href="/listings/category/arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p>Arctic</p></a
    >
  </div>

  <div class="filter">
    <a href="/listings/category/domes"
      ><div><i class="fa-solid fa-igloo"></i></div>
      <p>Domes</p></a
    >
  </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% for (let list of listings) { %> <% if(list.category== "Castles"){%>
  <div class="col">
    <a
      href="/listings/<%= list._id %>"
      style="text-decoration: none; color: inherit"
    >
      <div class="card listing-card h-100">
        <!-- Image Section -->
        <div style="overflow: hidden; position: relative">
          <% if (list.images && list.images.length > 0) { %>
          <img
            src="<%= list.images[0].url %>"
            class="card-img-top"
            alt="<%= list.title %>"
          />
          <% } else { %>
          <img
            src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=400"
            class="card-img-top"
            alt="No image"
          />
          <% } %>
        </div>

        <!-- Card Body -->
        <div class="card-body d-flex flex-column">
          <h5 class="card-title mb-2 text-truncate" style="font-weight: 600">
            <%= list.title %>
          </h5>

          <p class="card-text text-muted mb-2" style="font-size: 0.9rem">
            <i class="fa-solid fa-location-dot me-1"></i>
            <%= list.location %>, <%= list.country %>
          </p>

          <div class="mt-auto">
            <p class="card-text mb-1">
              <strong style="font-size: 1.1rem"
                >&#8377;<%= list.price.toLocaleString("en-IN") %></strong
              >
              <span class="text-muted" style="font-size: 0.85rem">
                / night</span
              >
            </p>
            <p class="card-text">
              <small class="text-muted">+18% GST</small>
            </p>
          </div>
        </div>
      </div>
    </a>
  </div>
  <% }} %>
</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for (info of taxInfo) {
      if (info.style.display != "inline") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });

  let filters = document.getElementById("filter");
  filters.addEventListener("click", () => {});
</script>
