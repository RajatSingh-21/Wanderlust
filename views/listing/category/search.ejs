<% layout("/layouts/boilerplate") %>

<div class="container">
  <div class="row mt-4">
    <div class="col-12">
      <h2 class="mb-4">Search Results for "<%= search %>"</h2>
      <p class="text-muted"><%= listings.length %> listing(s) found</p>
    </div>

    <% if (listings && listings.length > 0) { %> <% for (let list of listings) {
    %>
    <div class="col-12 col-md-6 col-lg-4 mb-4">
      <a href="/listings/<%= list._id %>" style="text-decoration: none">
        <div class="card listing-card h-100">
          <% if (list.images && list.images.length > 0) { %>
          <img
            src="<%= list.images[0].url %>"
            class="card-img-top"
            alt="<%= list.title %>"
            style="height: 20em; object-fit: cover"
          />
          <% } else { %>
          <img
            src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=400"
            class="card-img-top"
            alt="No image"
            style="height: 20em; object-fit: cover"
          />
          <% } %>

          <div class="card-body">
            <p class="card-text mb-1">
              <b><%= list.title %></b>
            </p>
            <p class="card-text text-muted mb-2">
              <small
                ><i class="fa-solid fa-location-dot"></i> <%= list.location %>,
                <%= list.country %>
              </small>
            </p>
            <p class="card-text mb-0">
              <strong>&#8377; <%= list.price.toLocaleString("en-IN") %></strong>
              / night
              <br />
              <small class="text-muted">+18% GST</small>
            </p>
          </div>
        </div>
      </a>
    </div>
    <% } %> <% } else { %>
    <div class="col-12">
      <div class="alert alert-warning text-center" role="alert">
        <h4>No listings found for "<%= search %>"</h4>
        <p>Try searching with different keywords like:</p>
        <ul class="list-unstyled">
          <li>Location names (e.g., "India", "USA")</li>
          <li>Property types (e.g., "Cabin", "Lodge")</li>
          <li>Specific features (e.g., "Beach", "Mountain")</li>
        </ul>
        <a href="/listings" class="btn btn-primary mt-3">Browse All Listings</a>
      </div>
    </div>
    <% } %>
  </div>
</div>
